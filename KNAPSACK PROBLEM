#include <iostream>
#include <vector>
#include <algorithm>

// Function to solve the 0-1 Knapsack problem
// Time Complexity: O(N * W), Space Complexity: O(W)
int knapsack(int W, const std::vector<int>& weights, const std::vector<int>& values, int n) {
    // dp array stores the maximum value for every capacity from 0 to W
    std::vector<int> dp(W + 1, 0);

    // Process each item one by one
    for (int i = 0; i < n; i++) {
        // Traverse capacity from right to left to prevent using the same item multiple times
        for (int w = W; w >= weights[i]; w--) {
            dp[w] = std::max(dp[w], dp[w - weights[i]] + values[i]);
        }
    }

    return dp[W];
}

int main() {
    // Example Dataset
    std::vector<int> values = {10, 20, 25, 40, 60, 70};
    std::vector<int> weights = {1, 2, 3, 6, 7, 4};
    int W = 7; // Maximum weight capacity
    int n = values.size();

    int max_value = knapsack(W, weights, values, n);

    std::vector<int> elements;
    std::cout << "Maximum value in Knapsack = " << max_value << std::endl;

    return 0;
}
