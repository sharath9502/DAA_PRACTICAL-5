#include <iostream>
#include <vector>
#include <algorithm>

// Function to solve the 0/1 Knapsack problem using Dynamic Programming
int knapsack(int W, const std::vector<int>& weights, const std::vector<int>& values, int n) {
    // Create a 2D DP table initialized to 0
    // Rows represent items considered (0 to n)
    // Columns represent knapsack capacities (0 to W)
    std::vector<std::vector<int>> dp(n + 1, std::vector<int>(W + 1, 0));

    // Build the table in a bottom-up manner
    for (int i = 1; i <= n; ++i) {
        for (int w = 1; w <= W; ++w) {
            // Check if the weight of the current item is less than or equal to the current capacity
            if (weights[i - 1] <= w) {
                // Max of:
                // 1. Including the current item (its value + value of remaining capacity with previous items)
                // 2. Excluding the current item (value of the same capacity with previous items)
                dp[i][w] = std::max(values[i - 1] + dp[i - 1][w - weights[i - 1]], dp[i - 1][w]);
            } else {
                // Current item cannot be included because it exceeds the current capacity
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    // The bottom-right cell contains the maximum value for 'n' items and capacity 'W'
    return dp[n][W];
}

int main() {
    // Example inputs
    std::vector<int> values = {60, 100, 120};
    std::vector<int> weights = {10, 20, 30};
    int W = 50; // Total knapsack capacity
    int n = values.size();

    int max_value = knapsack(W, weights, values, n);

    std::cout << "Maximum value achievable in Knapsack = " << max_value << std::endl;

    return 0;
}
